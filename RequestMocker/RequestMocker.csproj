<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0.2</Version>
    <Description>This is a simple Request Mocker that will hep Fronted developer test endpoint till the actual endpoint is complete</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Product>RequestMocker</Product>
    <PackageId>RequestMocker</PackageId>
    <PackageReleaseNotes>starting point</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <Company>RequestMocker</Company>
    <Authors>RequestMocker</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
